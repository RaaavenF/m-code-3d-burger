# 复制为 .env.local 后填写。.env.local 已在 .gitignore 中。
# 切勿把真实 Token 提交到仓库。

# 麦当劳 MCP Server 地址
MCD_MCP_URL=https://mcp.mcd.cn

# 麦当劳 MCP Token，申请地址：https://open.mcd.cn/mcp
MCD_MCP_TOKEN=your_mcp_token_here

# 冷启动兜底门店（可选）。留空则先查「收藏餐厅」，再按下面的城市关键词搜索
MCD_DEFAULT_STORE_CODE=

# 门店搜索用的城市/关键词（可选，NEXT_PUBLIC_ 前缀会被打进客户端）
NEXT_PUBLIC_MCD_CITY=北京
NEXT_PUBLIC_MCD_KEYWORD=麦当劳

# 置 1 强制离线模式，使用内置快照，便于无网调试
MCD_OFFLINE=0
